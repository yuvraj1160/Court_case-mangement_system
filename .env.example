# ---------------------------------------------------------------
# Court Case Management System — Environment Variables Template
# ---------------------------------------------------------------
# Copy this file to .env at the project root:
#     cp .env.example .env        (Linux / macOS)
#     copy .env.example .env      (Windows)
#
# Fill in your DEVELOPMENT database credentials below.
# NEVER commit .env to version control.
# NEVER point DB_NAME at the production database (court_case_db).
# ---------------------------------------------------------------

# Database Configuration (Development Only)
DB_HOST=localhost
DB_NAME=court_case_dev
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_PORT=5432

# Flask Security & Cryptographic Signing
SECRET_KEY=generate_a_strong_random_secret_key_here

# Server-Side Session Configuration (Flask-Session)
SESSION_TYPE=filesystem
SESSION_FILE_DIR=.flask_session
SESSION_COOKIE_NAME=ccms_session
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False

# Reverse Proxy Configuration (ProxyFix)
USE_PROXYFIX=False
TRUSTED_PROXIES=1
